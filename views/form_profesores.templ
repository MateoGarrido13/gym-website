package views

templ ProfesorCreateFields(data PageData) {
	@IdentityFields(data)
	<label class="field">
		<span>Especialidad</span>
		<input type="text" name="especialidad" value={ data.FormValues.Especialidad } placeholder="Ej. Musculación, yoga"/>
	</label>
}

templ ProfesorEditFields(data PageData) {
	<label class="field field-wide">
		<span>Especialidad</span>
		<input type="text" name="especialidad" value={ data.FormValues.Especialidad } placeholder="Ej. Musculación, yoga"/>
	</label>
}
