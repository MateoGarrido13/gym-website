package views

// Bloques de formulario que se repiten en más de un kind.

// IdentityFields son los datos de usuario que se piden al dar de alta un
// alumno o un profesor.
templ IdentityFields(data PageData) {
	<label class="field">
		<span>Nombre <b class="required-mark">*</b></span>
		<input type="text" name="nombre" value={ data.FormValues.Nombre } required autocomplete="given-name"/>
	</label>
	<label class="field">
		<span>Apellido <b class="required-mark">*</b></span>
		<input type="text" name="apellido" value={ data.FormValues.Apellido } required autocomplete="family-name"/>
	</label>
	<label class="field">
		<span>Correo electrónico <b class="required-mark">*</b></span>
		<input type="email" name="email" value={ data.FormValues.Email } required autocomplete="email"/>
	</label>
	<label class="field">
		<span>Contraseña <b class="required-mark">*</b></span>
		<input type="password" name="contrasena" required autocomplete="new-password"/>
	</label>
	<label class="field">
		<span>Teléfono</span>
		<input type="tel" name="telefono" value={ data.FormValues.Telefono } autocomplete="tel"/>
	</label>
}

// PlanFields son los datos del plan de un alumno (alta y edición).
templ PlanFields(data PageData) {
	<label class="field">
		<span>Tipo de plan</span>
		<select name="tipo_plan" id="tipo_plan" onchange="previewVto(this.value)">
			<option value="" if data.FormValues.TipoPlan == "" { selected }>Seleccionar plan</option>
			<option value="Mensual" if data.FormValues.TipoPlan == "Mensual" { selected }>Mensual</option>
			<option value="Trimestral" if data.FormValues.TipoPlan == "Trimestral" { selected }>Trimestral</option>
			<option value="Anual" if data.FormValues.TipoPlan == "Anual" { selected }>Anual</option>
		</select>
	</label>
	<label class="field">
		<span>Fecha de vencimiento</span>
		<input type="date" id="fecha_vto_preview" value={ data.FormValues.FechaVto } readonly disabled/>
		<small>Se calcula automáticamente según el plan elegido.</small>
	</label>
	<script>
		function previewVto(plan) {
			var meses = { Mensual: 1, Trimestral: 3, Anual: 12 }[plan];
			var el = document.getElementById("fecha_vto_preview");
			if (!meses) { el.value = ""; return; }
			var d = new Date();
			d.setMonth(d.getMonth() + meses);
			el.value = d.toISOString().slice(0, 10);
		}
	</script>
}

// ProfesorSelect lo usan rutinas y clases.
templ ProfesorSelect(data PageData) {
	<label class="field">
		<span>Profesor responsable <b class="required-mark">*</b></span>
		<select name="profesor_id" required>
			<option value="">Selecciona un profesor</option>
			for _, option := range data.Options {
				if data.FormValues.ProfesorID == stringID(option.ID) {
					<option value={ stringID(option.ID) } selected>{ option.Label }</option>
				} else {
					<option value={ stringID(option.ID) }>{ option.Label }</option>
				}
			}
		</select>
		if len(data.Options) == 0 {
			<small>Primero registra un profesor para asignarlo.</small>
		}
	</label>
}
