package views

templ AlumnosList(data PageData) {
	<section id="entity-list" class="panel list-panel server-list-panel">
		<div class="server-panel-heading">
			<div>
				<p class="eyebrow">REGISTROS</p>
				<h3>Registros @ResultCount(data.Total, false)</h3>
			</div>
		</div>
		<div class="table-wrap">
			<table>
				<thead>
					<tr>
						for _, header := range data.Headers {
							<th scope="col">{ header }</th>
						}
						if data.ShowActions {
							<th scope="col">ACCIONES</th>
						}
					</tr>
				</thead>
				<tbody id="entity-rows">
					if len(data.Entities) == 0 {
						<tr id="empty-row"><td colspan={ intString(len(data.Headers) + boolInt(data.ShowActions)) } class="table-empty">Todavía no hay registros. Usa el formulario para agregar el primero.</td></tr>
					} else {
						for _, entity := range data.Entities {
							@EntityRow(entity, data.ShowActions)
						}
					}
				</tbody>
			</table>
		</div>
		if data.Offset > 0 || data.Offset+data.Limit < data.Total {
			<nav class="pager" aria-label="Páginas">
				if data.Offset > 0 {
					<a class="button button-secondary" href={ alumnosPageHref(data.Limit, previousOffset(data.Offset, data.Limit)) } hx-get={ alumnosPageHref(data.Limit, previousOffset(data.Offset, data.Limit)) } hx-target="#entity-list" hx-swap="outerHTML" hx-push-url="true">Anterior</a>
				}
				if data.Offset+data.Limit < data.Total {
					<a class="button button-secondary" href={ alumnosPageHref(data.Limit, data.Offset+data.Limit) } hx-get={ alumnosPageHref(data.Limit, data.Offset+data.Limit) } hx-target="#entity-list" hx-swap="outerHTML" hx-push-url="true">Siguiente</a>
				}
			</nav>
		}
	</section>
}
