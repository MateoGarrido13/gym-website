package views

// Logo es la marca de Gym Web: un brazo flexionado. Es de relleno y toma el
// color del texto (currentColor), así se adapta al fondo donde se use.
//
// El dibujo es el ícono "arm-flex" de Material Design Icons (Pictogrammers),
// licencia Apache 2.0: https://pictogrammers.com/library/mdi/icon/arm-flex/
templ Logo() {
	<span class="brand-mark" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="currentColor">
			<path d="M3 18.34C3 18.34 4 7.09 7 3L12 4L11 7.09H9V14.25H10C12 11.18 16.14 10.06 18.64 11.18C21.94 12.71 21.64 17.32 18.64 19.36C16.24 21 9 22.43 3 18.34Z"></path>
		</svg>
	</span>
}
