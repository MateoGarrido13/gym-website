package views

templ EntityForm(data PageData) {
<section class="panel server-form-panel">
	<div class="server-panel-heading">
		<div>
			if data.IsEditing {
			<p class="eyebrow">EDITAR REGISTRO</p>
			<h3>Editar { singularKind(data.Kind) }</h3>
			} else {
			<p class="eyebrow">NUEVO REGISTRO</p>
			<h3>Registrar { singularKind(data.Kind) }</h3>
			}
		</div>
	</div>
	if data.FormError != "" {
	<p class="form-error" role="alert">{ data.FormError }</p>
	}
	<!-- Solo en alta (no edición): hx-post manda el form sin recargar, hx-target
		     dice que la respuesta va a #entity-list, y outerHTML la reemplaza entera. -->
	<form class="server-form" method="post" action={ data.Action } if !data.IsEditing { hx-post={ data.Action }
		hx-target="#entity-list" hx-swap="beforeend" }>
		<div class="server-fields">
			@kindFields(data)
		</div>
		<div class="server-form-actions">
			if data.IsEditing {
			<a class="button button-secondary" href={ catalogPath(data.Kind) }>Cancelar</a>
			<button class="button button-primary" type="submit">Guardar cambios</button>
			} else {
			<button class="button button-primary" type="submit">Guardar registro</button>
			}
		</div>
	</form>
</section>
}

// kindFields elige los campos según el kind y si es alta o edición.
templ kindFields(data PageData) {
	switch data.Kind {
		case "ejercicios":
			@EjercicioFields(data)
		case "rutinas":
			@RutinaFields(data)
		case "clases":
			@ClaseFields(data)
		case "profesores":
			if data.IsEditing {
				@ProfesorEditFields(data)
			} else {
				@ProfesorCreateFields(data)
			}
		default:
			if data.IsEditing {
				@AlumnoEditFields(data)
			} else {
				@AlumnoCreateFields(data)
			}
	}
}
