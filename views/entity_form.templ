package views

templ EntityForm(data PageData) {
<section class="panel server-form-panel">
	<div class="server-panel-heading">
		<div>
			if data.IsEditing {
			<p class="eyebrow">EDITAR REGISTRO</p>
			<h3>Editar { singularKind(data.Kind) }</h3>
			} else {
			<p class="eyebrow">NUEVO REGISTRO</p>
			<h3>Registrar { singularKind(data.Kind) }</h3>
			}
		</div>
	</div>
	@FormError(data.FormError, false)
	if data.SuccessMessage != "" {
		<div class="form-success" role="status">
			{ data.SuccessMessage }
		</div>
	}
	<!-- Solo en alta (no edición): hx-post manda el form sin recargar.
	     Alumnos responde con HX-Redirect a su página ordenada. El resto,
	     si el alta es válida, devuelve la página completa y el handler pide
	     reemplazar el contenido del body, sin cambiar la URL. Si falla, el
	     target sigue siendo #entity-rows
	     y el error llega como fragmento hx-swap-oob. -->
	<form class="server-form" method="post" action={ data.Action } if !data.IsEditing { hx-post={ data.Action }
		hx-target="#entity-rows" hx-swap="beforeend" }>
		<div class="server-fields">
			@kindFields(data)
		</div>
		<div class="server-form-actions">
			if data.IsEditing {
			<a class="button button-secondary" href={ catalogPath(data.Kind) }>Cancelar</a>
			<button class="button button-primary" type="submit">Guardar cambios</button>
			} else {
			<button class="button button-primary" type="submit">Guardar registro</button>
			}
		</div>
	</form>
</section>
}

// FormError es el mensaje de error del formulario. EntityForm lo llama con
// oob=false en la carga normal (no se ve si no hay mensaje); el handler de
// alta lo llama con oob=true para avisar el error sin devolver la página
// completa, evitando que HTMX la pegue adentro de una fila de la tabla.
templ FormError(message string, oob bool) {
	<p id="form-error" class="form-error" role="alert" if oob { hx-swap-oob="true" } if message == "" { hidden }>{ message }</p>
}

// kindFields elige los campos según el kind y si es alta o edición.
templ kindFields(data PageData) {
	switch data.Kind {
		case "ejercicios":
			@EjercicioFields(data)
		case "rutinas":
			@RutinaFields(data)
		case "clases":
			@ClaseFields(data)
		case "profesores":
			if data.IsEditing {
				@ProfesorEditFields(data)
			} else {
				@ProfesorCreateFields(data)
			}
		default:
			if data.IsEditing {
				@AlumnoEditFields(data)
			} else {
				@AlumnoCreateFields(data)
			}
	}
}
