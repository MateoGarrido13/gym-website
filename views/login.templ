package views

// LoginPage es independiente de Layout: no lleva el menú de administración.
// Sin rol elegido muestra los accesos; con rol, el formulario de ese rol.
templ LoginPage(data LoginData) {
	<!doctype html>
	<html lang="es">
		@simpleHead("Entrar")
		<body class="login-body">
			<main class="login">
				<a class="brand login-brand" href="/login" aria-label="Gym Web">
					@Logo()
					<span>Gym Web</span>
				</a>
				<section class="login-card panel">
					if data.Rol == "" {
						<header class="login-header">
							<h1>Bienvenido</h1>
							<p>¿Cómo quieres entrar?</p>
						</header>
					} else {
						<header class="login-header">
							<p class="eyebrow login-role-tag">Entrar como { data.Rol }</p>
							<h1>Iniciar sesión</h1>
							<p>Ingresa con tu correo y tu contraseña.</p>
						</header>
					}
					if data.Error != "" {
						<p class="form-error login-error" role="alert">{ data.Error }</p>
					}
					if data.Rol == "" {
						<nav class="login-roles" aria-label="Tipo de acceso">
							<a class="role-option" href="/login?rol=profesor">
								<strong>Entrar como profesor</strong>
								<span>Gestiona alumnos, rutinas, ejercicios y clases.</span>
							</a>
							<a class="role-option" href="/login?rol=alumno">
								<strong>Entrar como alumno</strong>
								<span>Consulta tu rutina de entrenamiento.</span>
							</a>
							<a class="role-option" href="/login?rol=administrador">
								<strong>Entrar como administrador</strong>
								<span>Gestiona profesores y alumnos.</span>
							</a>
						</nav>
					} else {
						<form class="server-form" method="post" action="/login">
							<input type="hidden" name="rol" value={ data.Rol }/>
							<label class="field">
								Correo electrónico
								<input type="email" name="email" value={ data.Email } autocomplete="username" required autofocus/>
							</label>
							<label class="field">
								Contraseña
								<input type="password" name="contrasena" autocomplete="current-password" required/>
							</label>
							<button class="button button-primary button-block" type="submit">Entrar</button>
						</form>
						<a class="login-switch" href="/login">← Cambiar de rol</a>
					}
				</section>
			</main>
		</body>
	</html>
}
