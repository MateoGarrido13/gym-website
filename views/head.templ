package views

// simpleHead es el <head> de las páginas sin HTMX (login y vista del alumno).
templ simpleHead(title string) {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta name="theme-color" content="#111b18"/>
		<title>{ title + " | Gym Web" }</title>
		<link rel="stylesheet" href="/static/styles.css"/>
	</head>
}
